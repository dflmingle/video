# Archive supplied native sources and the runtime model/animation bundle.
assets/*
!assets/imported/
!assets/runtime/
!assets/references/
!assets/source-packages/
node_modules/
# Preserve the current complete preview's exact runtime data; historical
# experiment caches and duplicated NumPy/checkpoint files stay local.
variants/*
!variants/V22R-topfield-T1/
variants/V22R-topfield-T1/*
!variants/V22R-topfield-T1/*.f32
!variants/V22R-topfield-T1/*.json
!variants/V22R-topfield-T1-seed/
variants/V22R-topfield-T1-seed/*
!variants/V22R-topfield-T1-seed/params.json
output/
dist/
__pycache__/
*.pyc
.venv/
public/native-scenes/native-scenes/
